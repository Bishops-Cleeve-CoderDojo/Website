---
import { Image } from 'astro:assets'
import logo from '../images/CoderDojoSplitdarkbg.svg'
import Button from './Button.astro'
import SocialLinks from './SocialLinks.astro'
---

<div class="px-8 pt-6 pb-2 flex flex-col items-center text-center">
  <Image
    src={logo}
    alt="CoderDojo Logo"
    class="w-64 h-auto mt-6"
    loading="eager"
  />
  <h1 class="mb-4 font-medium lg:text-2xl">@ Bishops Cleeve</h1>
  <div class="lg:text-xl">
    <p>A free coding club for children ages 7-14,</p>
    <p>running every other Saturday 1pm-2.30pm,</p>
    <p>at the Bishops Cleeve Library, near Cheltenham, Gloucestershire.</p>
  </div>
  <div class="flex space-x-2">
    <Button
      href="https://codeclub.org/en/clubs/b05ca2dc-65c8-4501-bf67-869acc1773c9"
      external
    >
      Book a Session
    </Button>
    <Button href="/volunteers" colour="teal">
      Volunteer
    </Button>
  </div>
  <SocialLinks class="flex space-x-2 mt-2" />
</div>
