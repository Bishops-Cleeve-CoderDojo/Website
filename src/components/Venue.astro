---
import { Image } from 'astro:assets'
import map from '../images/library_map.jpeg'

const mapUrl = 'https://goo.gl/maps/dPZkUv5ch4C4Dy328'
---

<section id="venue" class="p-8 flex flex-col items-center space-y-4">
  <h2>Venue</h2>
  <p>Our CoderDojo runs at the Bishops Cleeve Library.</p>
  <p>
    Address:{' '}
    <a href={mapUrl} target="_blank" rel="noreferrer">
      Tobyfield Rd, Bishops Cleeve, Cheltenham GL52 8NN
    </a>
  </p>
  <a href={mapUrl} target="_blank" rel="noreferrer">
    <Image
      src={map}
      alt="Map of Bishops Cleeve"
      class="rounded-sm max-w-full h-auto"
    />
  </a>
</section>
