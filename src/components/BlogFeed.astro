---
import { getCollection } from 'astro:content'
import Button from './Button.astro'
import { formatDate } from '../utils/utils'

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
---

<section class="p-6 flex flex-col items-center bg-slate-100">
  <h2>Blog</h2>
  <div class="py-4 grid grid-cols-1 gap-6 lg:grid-cols-3 text-justify">
    {posts.map(post => (
      <article class="text-center">
        <h2>
          <a href={`/blog/${post.id}`}>{post.data.title}</a>
        </h2>
        <p class="italic text-xs">{formatDate(post.data.date)}</p>
      </article>
    ))}
  </div>
  <Button href="/blog" colour="teal">
    Older Posts
  </Button>
</section>
