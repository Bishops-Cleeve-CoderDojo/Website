---
import { Image } from 'astro:assets'
import roundel from '../images/Roundel.png'
import SocialLinks from './SocialLinks.astro'

const { siteTitle } = Astro.props

const links = [
  { url: '/#about', display: 'About' },
  { url: '/blog', display: 'Blog' },
  { url: '/#activities', display: 'Activities' },
  { url: '/#faq', display: 'FAQ' },
  { url: '/#venue', display: 'Venue' },
  { url: '/blog/volunteers', display: 'Volunteer' },
  { url: '/#contact', display: 'Contact' },
]
---

<nav class="py-2 px-4">
  <div class="max-w-5xl mx-auto flex flex-wrap items-center justify-between lg:py-2 mt-2">
    <a href="/" class="text-white">
      <div class="flex items-center shrink-0">
        <Image
          src={roundel}
          width={32}
          alt="Logo"
          class="mr-2 w-8 h-auto"
          loading="eager"
        />
        <span class="text-xl font-semibold tracking-tight">{siteTitle}</span>
      </div>
    </a>
    <div class="block lg:hidden">
      <button
        id="nav-toggle"
        class="flex items-center px-3 py-2 border border-black rounded-sm"
        aria-controls="nav-links"
        aria-expanded="false"
      >
        <svg
          class="w-3 h-3 fill-current"
          viewBox="0 0 20 20"
          xmlns="http://www.w3.org/2000/svg"
        >
          <title>Menu</title>
          <path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"></path>
        </svg>
      </button>
    </div>
    <div
      id="nav-links"
      class="hidden w-full grow lg:flex lg:items-center justify-end lg:w-auto"
    >
      <div class="flex flex-col items-center text-lg justify-end lg:flex-row lg:grow">
        {links.map(link => (
          <a
            href={link.url}
            class="text-white block mt-4 mx-4 lg:inline-block lg:mt-0"
          >
            {link.display}
          </a>
        ))}
        <SocialLinks class="flex items-center space-x-4 lg:space-x-0 mt-6 mb-4 lg:my-0 lg:ml-4" />
      </div>
    </div>
  </div>
</nav>

<script>
  const toggle = document.querySelector('#nav-toggle')
  const links = document.querySelector('#nav-links')
  toggle?.addEventListener('click', () => {
    const open = links?.classList.toggle('hidden') === false
    toggle.setAttribute('aria-expanded', String(open))
  })
</script>
