---
import { getCollection, render } from 'astro:content'
import { Image } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import roundel from '../../images/Roundel.png'
import { formatDate } from '../../utils/utils'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
const { title, author, date, featuredImage } = post.data
---

<BaseLayout pageTitle={title}>
  <div class="m-4 overflow-hidden rounded-sm bg-white text-black">
    <div class="grid h-48 lg:h-52">
      <div class="row-start-1 col-start-1 bg-purple-900 h-48 lg:h-52"></div>
      {featuredImage && (
        <Image
          src={featuredImage}
          width={1024}
          alt=""
          class="row-start-1 col-start-1 w-full h-48 lg:h-52 object-cover brightness-50"
        />
      )}
      <div class="row-start-1 col-start-1 relative flex flex-col justify-end">
        <h1 class="text-center text-white pt-10 pb-2 text-3xl lg:text-4xl">
          {title}
        </h1>
        <h2 class="text-xs text-slate-200 font-normal text-center pb-8">
          Posted by {author} on {formatDate(date)}
        </h2>
      </div>
    </div>

    <div class="max-w-2xl mx-auto p-4">
      <article class="prose prose-slate pt-2 pb-6 mx-auto">
        <Content />
      </article>

      <a href="/blog">&larr; Back to blog index</a>

      <hr class="my-5" />
    </div>

    <div class="flex px-8 pb-6 text-slate-600 max-w-xl mx-auto">
      <div class="hidden md:block pr-4 pt-2">
        <Image src={roundel} alt="CoderDojo Logo" class="w-24 h-auto" />
      </div>
      <div>
        <p class="pb-4">
          CoderDojo Bishops Cleeve is a free coding club for children, located
          near Cheltenham in the UK. Find out more on our{' '}
          <a href="/">home page.</a>
        </p>
        <p>
          For more club news and coding articles, follow us on{' '}
          <a
            href="https://www.instagram.com/coderdojobc/"
            target="_blank"
            rel="noreferrer"
          >
            Instagram
          </a>{' '}
          or{' '}
          <a
            href="https://www.facebook.com/BishopsCleeveCoderDojo/"
            target="_blank"
            rel="noreferrer"
          >
            Facebook
          </a>
          .
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
