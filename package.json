{
  "name": "bccd",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Website for Bishops Cleeve CoderDojo, a free coding club for kids",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write \"**/*.{js,mjs,ts,astro,json,md,css}\"",
    "test": "npm run build && playwright test",
    "test:ui": "npm run build && playwright test --ui",
    "test:headed": "npm run build && playwright test --headed"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@tailwindcss/vite": "^4.1.12",
    "astro": "^7.3.3",
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/typography": "^0.5.16",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^1.0.1"
  },
  "license": "MIT"
}
